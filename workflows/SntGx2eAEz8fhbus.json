    {
      "parameters": {
        "jsCode": "const hire = $('Parse New Hire + Config').first().json;\n\nconst notionItem = $('Notion: Create Onboarding Entry').first().json || {};\nconst driveFolder = $('Google Drive: Create Employee Folder').first().json || {};\nconst slackChannel = $('Slack: Create Onboarding Channel').first().json || {};\nconst emailRes = $('Outlook: Send Welcome Email').first().json || {};\n\nconst notionSuccess = notionItem.id ? '✅ Notion Page ID: ' + notionItem.id : '❌ Notion Entry Failed';\nconst driveSuccess = driveFolder.id ? '✅ Google Drive Folder Provisioned (' + driveFolder.id + ')' : '❌ Google Drive Provisioning Failed';\nconst slackSuccess = slackChannel.id ? '✅ Slack Channel Created (' + slackChannel.id + ')' : '❌ Slack Channel Creation Failed';\nconst emailSuccess = emailRes.id ? '✅ Welcome email sent to ' + hire.email : '❌ AI Generation or Email Failed';\n\nconst summary = [\n  '🎉 New Team Member Onboarded: ' + hire.fullName,\n  '',\n  '*Role:* ' + hire.role,\n  '*Department:* ' + hire.department,\n  '*Start Date:* ' + hire.startDate,\n  '*Location:* ' + hire.location,\n  '*Manager:* ' + (hire.managerEmail || 'TBD'),\n  '',\n  '*Onboarding Task Status:*',\n  notionSuccess,\n  driveSuccess,\n  slackSuccess,\n  emailSuccess\n].join('\\n');\n\nreturn [{ json: { summary } }];"
      },
