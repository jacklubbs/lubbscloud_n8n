    {
      "parameters": {
        "jsCode": "const errorData = $input.first().json;\n\nconst summary = [\n  '🚨 Onboarding Workflow Critical Failure',\n  '',\n  '*Failed Node:* ' + errorData.execution.lastNodeExecuted,\n  '*Error Message:* ' + errorData.execution.error.message,\n  '*Workflow ID:* ' + errorData.workflow.id\n].join('\\n');\n\nreturn [{ json: { summary } }];"
      },
